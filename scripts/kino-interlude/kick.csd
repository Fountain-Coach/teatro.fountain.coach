instr 1
 kHz expseg 155, .09, 51, p3-.09, 45
 aEnv expseg 1, .10, .2, p3-.10, .001
 aBody oscili .68, kHz
 aKick = aBody*aEnv
 outs aKick, aKick
endin

instr 2
 aN rand .62
 aN butterhp aN, 6300
 aEnv linseg 0, .005, 1, .095, .0, p3-.10, 0
 aHat=aN*aEnv*p4
 outs aHat*.64,aHat
endin

instr 3
 iHz cpsmidinn p4
 aSaw vco2 .18,iHz,0
 aSub oscili .17,iHz*.5
 aFilt moogladder aSaw+aSub, 800,.12
 aEnv linseg 0,.015,1,p3-.13,.8,.115,0
 aOut=aFilt*aEnv*.70
 outs aOut,aOut
endin

instr 4
 iHz cpsmidinn p4
 a1 vco2 .08,iHz,0
 a2 vco2 .08,iHz*1.005,0
 aTone butterlp a1+a2,1900
 aEnv linen 1,.055,p3,.36
 aOut=aTone*aEnv
 outs aOut*.70,aOut
endin

instr 5
 iHz cpsmidinn p4
 a1 oscili .12,iHz
 a2 oscili .07,iHz*2.006
 aEnv linen 1,.009,p3,.31
 aSig=(a1+a2)*aEnv
 aDel delay aSig,.17
 aOut=aSig+aDel*.28
 outs aOut*.72,aOut
endin

